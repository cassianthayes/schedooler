# Telegram Bot API
# Create a bot with @BotFather and add it to the target channel as an admin.
# Do not commit the real .env file.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=@your_channel_or_-1001234567890

# Numeric Telegram user id that receives a warning when a run fails.
# That user must have started a chat with the bot.
TELEGRAM_ALERT_USER_ID=123456789

# MAX channel mirrored to Telegram, e.g. https://max.ru/id5903158943_gos
MAX_CHANNEL_URL=https://max.ru/id5903158943_gos
